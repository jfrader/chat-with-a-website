{
  "name": "@chat-with-a-website/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "public"
  ],
  "exports": {
    ".": {
      "development": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsup src/app.ts src/server.ts --format esm --clean && tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=development src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chat-with-a-website/contracts": "workspace:*",
    "@chat-with-a-website/db": "workspace:*",
    "@hono/node-server": "2.1.1",
    "cheerio": "1.2.0",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "ipaddr.js": "2.5.0",
    "openai": "7.5.0",
    "rate-limiter-flexible": "11.2.1",
    "undici": "7.29.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
